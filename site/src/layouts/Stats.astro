---
import Sheet from '../components/Sheet.astro';
import { basePath } from '../lib/i18n';
import { pagePath } from '../lib/links';
import Base from './Base.astro';

interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
const { l } = Astro.locals;
const path = basePath(pagePath(Astro.url));
const tabs = [
  ['/stats', l.t('Overview')],
  ['/stats/cards', l.t('Cards')],
  ['/stats/mechanics', l.t('Mechanics')],
  ['/stats/relics', l.t('Relics and potions')],
  ['/stats/fights', l.t('Fights')],
  ['/stats/versions', l.t('Versions')],
];
---

<Base description={description} title={title}>
  <nav aria-label={l.t('Stats')} class="-mx-4 mt-4 overflow-x-auto px-4 [scrollbar-width:none]">
    <ul class="m-0 flex list-none gap-1 border-b border-line p-0">
      {tabs.map(([href, label]) => (
        <li>
          <a
            aria-current={path === href ? 'page' : undefined}
            class="-mb-px block border-b-2 border-transparent px-3 py-2.5 text-sm whitespace-nowrap text-ink-2 no-underline hover:text-ink aria-[current=page]:border-accent aria-[current=page]:text-ink"
            data-keep-filters
            href={l.href(href)}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <h1 class="mt-6 mb-4 text-4xl">{title}</h1>
  <slot />
  <Sheet slot="end" />
</Base>
