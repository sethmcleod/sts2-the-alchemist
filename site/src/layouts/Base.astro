---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import head from '../../../Alchemist/images/charui/character_icon_alchemist.png';
import appIcon from '../../../workshop/image.png';
import kreonBold from '../assets/fonts/card-latin-bold.woff2?url';
import kreonRegular from '../assets/fonts/card-latin-regular.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Insights from '../components/Insights.astro';
import { image, runs } from '../lib/content';
import { cardFont } from '../lib/fit';
import { basePath, LOCALES } from '../lib/i18n';
import { Lang } from '../lib/lang';
import { pagePath } from '../lib/links';
import { PLACING } from '../scripts/placing.mjs';
import { SPECULATION } from '../scripts/speculation.mjs';

interface Props {
  description?: string;
  /** The page's own picture for a link preview: a card's art, an item's icon */
  image?: ImageMetadata | null;
  /** Kept out of search results: the offline and not-found pages */
  noindex?: boolean;
  title?: string;
}

const { l, locale } = Astro.locals;
const {
  description = l.t(
    'The Alchemist, a Slay the Spire 2 character mod: every card, relic, potion and power, the patch notes, and stats from thousands of runs.',
  ),
  image: pageImage,
  noindex = false,
  title,
} = Astro.props;

const fullTitle = title ? `${title} · The Alchemist` : `The Alchemist · ${l.t('Slay the Spire 2 character mod')}`;
const canonical = new URL(pagePath(Astro.url), Astro.site);
const favicon = await getImage({ format: 'png', src: head, width: 64 });
// A link preview shows the page's own picture beside its text, or else a wide Workshop screenshot
const preview = pageImage ?? (await image(runs().meta.previews[0]?.image));
const social =
  preview &&
  (await getImage({
    format: pageImage ? 'png' : 'jpg',
    quality: 80,
    src: preview,
    width: Math.min(preview.width, pageImage ? 600 : 1200),
  }));
const touchIcon = await getImage({ format: 'png', src: appIcon, width: 180 });
// Page views and Core Web Vitals go to Vercel only from a Vercel build, so local builds send nothing
const measured = process.env.VERCEL === '1';

// The same page in every language, for search engines
const path = basePath(pagePath(Astro.url));
const alternates = (path === '/404' ? [] : LOCALES).map((other) => ({
  href: new URL(new Lang(other).href(path), Astro.site),
  lang: other.lang,
}));
// A language that draws cards in another font than Kreon lays them out with its metrics (global.css)
const font = cardFont(locale.game);
const cardStyle =
  font.name === 'latin'
    ? undefined
    : `--font-card: card-${font.name}; --card-line: ${font.line}; --card-spacing: ${font.spacing}; ` +
      `--card-text-scale: ${font.regular.scale}; --card-title-scale: ${font.bold.scale}`;
---

<!doctype html>
<html lang={locale.lang} style={cardStyle}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={PLACING} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>{fullTitle}</title>
    <meta content={description} name="description" />
    {noindex && <meta content="noindex" name="robots" />}
    <link href={canonical} rel="canonical" />
    {alternates.map((other) => (
      <link href={other.href} hreflang={other.lang} rel="alternate" />
    ))}
    {alternates[0] && <link href={alternates[0].href} hreflang="x-default" rel="alternate" />}
    <meta content="dark" name="color-scheme" />
    <meta content="#1c1822" name="theme-color" />
    <link href={favicon.src} rel="icon" type="image/png" />
    <link href={touchIcon.src} rel="apple-touch-icon" />
    <link href="/manifest.webmanifest" rel="manifest" />
    <link href="/notes.xml" rel="alternate" title="The Alchemist patch notes" type="application/atom+xml" />
    <script is:inline set:html={SPECULATION} type="speculationrules" />
    {font.name === 'latin' && <link as="font" crossorigin href={kreonRegular} rel="preload" type="font/woff2" />}
    {font.name === 'latin' && <link as="font" crossorigin href={kreonBold} rel="preload" type="font/woff2" />}
    <meta content="website" property="og:type" />
    <meta content="The Alchemist" property="og:site_name" />
    <meta content={fullTitle} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonical} property="og:url" />
    {social && <meta content={new URL(social.src, Astro.site)} property="og:image" />}
    <meta content={pageImage ? 'summary' : 'summary_large_image'} name="twitter:card" />
  </head>
  <body class="min-h-dvh">
    <a class="skip-link" href="#main">
      {l.t('Skip to content')}
    </a>
    <Header />
    <main class="mx-auto w-full max-w-[80rem] px-4 pb-16" id="main">
      <slot />
    </main>
    <Footer />
    <slot name="end" />
    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
    </script>
    {measured && <Insights />}
  </body>
</html>
