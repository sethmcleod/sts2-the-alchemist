---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import kreonBold from '../assets/fonts/card-latin-bold.woff2?url';
import kreonRegular from '../assets/fonts/card-latin-regular.woff2?url';
import head from '../../../Alchemist/images/charui/character_icon_alchemist.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { image, runs } from '../lib/content';
import { cardFont } from '../lib/fit';
import { basePath, LOCALES } from '../lib/i18n';
import { Lang } from '../lib/lang';
import { pagePath } from '../lib/links';
import { PLACING } from '../scripts/placing.mjs';

interface Props {
  title?: string;
  description?: string;
}

const { l, locale } = Astro.locals;
const {
  title,
  description = l.t(
    'The Alchemist, a Slay the Spire 2 character mod: every card, relic, potion and power, the patch notes, and stats from thousands of runs.',
  ),
} = Astro.props;

const fullTitle = title ? `${title} · The Alchemist` : `The Alchemist · ${l.t('Slay the Spire 2 character mod')}`;
const canonical = new URL(pagePath(Astro.url), Astro.site);
const favicon = await getImage({ src: head, width: 64, format: 'png' });
const preview = await image(runs().meta.previews[0]?.image);
const social = preview && (await getImage({ src: preview, width: 1200, format: 'jpg', quality: 80 }));

// The same page in every language, for search engines
const path = basePath(pagePath(Astro.url));
const alternates = (path === '/404' ? [] : LOCALES).map((other) => ({
  lang: other.lang,
  href: new URL(new Lang(other).href(path), Astro.site),
}));
// A language that draws cards in another font than Kreon lays them out with its metrics (global.css)
const font = cardFont(locale.game);
const cardStyle =
  font.name === 'latin'
    ? undefined
    : `--font-card: card-${font.name}; --card-line: ${font.line}; --card-spacing: ${font.spacing}; ` +
      `--card-text-scale: ${font.regular.scale}; --card-title-scale: ${font.bold.scale}`;
---

<!doctype html>
<html lang={locale.lang} style={cardStyle}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={PLACING} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((other) => (
      <link rel="alternate" hreflang={other.lang} href={other.href} />
    ))}
    {alternates[0] && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1c1822" />
    <link rel="icon" href={favicon.src} type="image/png" />
    {font.name === 'latin' && <link rel="preload" href={kreonRegular} as="font" type="font/woff2" crossorigin />}
    {font.name === 'latin' && <link rel="preload" href={kreonBold} as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Alchemist" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {social && <meta property="og:image" content={new URL(social.src, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh">
    <a class="skip-link" href="#main">
      {l.t('Skip to content')}
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-[80rem] px-4 pb-16">
      <slot />
    </main>
    <Footer />
    <slot name="end" />
    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
    </script>
  </body>
</html>
