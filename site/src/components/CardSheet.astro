---
import { runs } from '../lib/content';
import { cardDetail } from '../lib/details';
import { cardKind, type LibraryCard } from '../lib/library';
import { cardHref, notesHref } from '../lib/links';
import { partnerMod, slug, steamItem } from '../lib/mod';
import Breakdown from './Breakdown.astro';
import CardFace from './CardFace.astro';
import Changes from './Changes.astro';
import Stats from './charts/Stats';
import Commentary from './Commentary.astro';
import External from './External.astro';
import StatsSpan from './StatsSpan.astro';
import T from './T.astro';
import Tips from './Tips.astro';
import UpgradeToggle from './UpgradeToggle.astro';

const { l } = Astro.locals;

interface Props {
  card: LibraryCard;
  next?: LibraryCard;
  previous?: LibraryCard;
}

const { card, next, previous } = Astro.props;
const { info } = card;
const runData = runs(Astro.locals.locale);
const detail = cardDetail(l, runData, card.id);
const partner = info.tags.map((tag) => partnerMod(tag)).find(Boolean);
const labels = [
  cardKind(l, info),
  ...info.themes.map((theme) => l.t(theme)),
  ...(info.tags.includes('Multiplayer') ? [l.t('Multiplayer only')] : []),
];
---

<article class="grid gap-6 p-5 sm:p-7" data-sheet>
  <header class="pr-12">
    <p class="m-0 text-sm text-muted">{labels.join(' · ')}</p>
    <h1 class="m-0 text-4xl" id="sheet-title" tabindex="-1">
      {info.name}
    </h1>
  </header>

  <div class="card-sheet">
    <div class="card relative mx-auto w-full max-w-[19rem] [grid-area:card]" data-place={card.id}>
      <CardFace eager info={info} width={[[null, '19rem']]} />
      <UpgradeToggle name={info.name} restoreOnReload={false} />
    </div>
    <Tips class="[grid-area:tips]" keywords={info.keywords} markups={info.texts} ownName={info.name} />
    <div class="grid content-start gap-4 [grid-area:stats]">
      {detail.stats.length > 0 && <Stats items={detail.stats} />}
      <p class="m-0 text-sm text-muted">
        <T text={l.t('Card text from {version}.')}>
          <a href={l.href(notesHref(runData.meta.mod.version))} slot="version">
            {runData.meta.mod.version}
          </a>
        </T>{' '}
        {detail.stats.length > 0 ? (
          <T
            text={l.n(
              detail.runs,
              'Stats from {n} run on {span}, at every ascension.',
              'Stats from {n} runs on {span}, at every ascension.',
            )}
          >
            <StatsSpan slot="span" />
          </T>
        ) : info.rarity === 'Token' ? (
          l.t('Made during a fight, so it never ends a run in a deck.')
        ) : (
          l.t('No run has finished with it yet.')
        )}
      </p>
      {partner && (
        <p class="m-0 text-sm">
          <T text={l.t('Needs {mod} installed as well.')}>
            <Fragment slot="mod">
              <External href={steamItem(partner.item)}>{partner.name}</External>
            </Fragment>
          </T>
        </p>
      )}
    </div>
  </div>

  {detail.breakdown && <Breakdown breakdown={detail.breakdown} />}

  <Commentary id={`cards/${slug(card.id)}`} />

  <Changes id={card.id} />

  <nav aria-label={l.t('More cards')} class="flex justify-between gap-4 border-t border-line pt-4 text-sm">
    {previous ? (
      <a data-sheet-link href={l.href(cardHref(previous.id))}>
        ← {previous.info.name}
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a data-sheet-link href={l.href(cardHref(next.id))}>
        {next.info.name} →
      </a>
    )}
  </nav>
</article>
