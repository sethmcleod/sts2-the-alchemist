---
import { Image } from 'astro:assets';
import characterIcon from '../../../Alchemist/images/charui/character_icon_alchemist.png';
import { basePath, LOCALES } from '../lib/i18n';
import { compendiumName } from '../lib/items';
import { Lang } from '../lib/lang';
import { pagePath } from '../lib/links';

const { l, locale } = Astro.locals;

const links = [
  { href: '/', label: l.t('Cards'), match: (path: string) => path === '/' || path.startsWith('/cards') },
  {
    href: '/compendium',
    label: compendiumName(l),
    match: (path: string) => /^\/(compendium|relics|potions|powers)(\/|$)/.test(path),
  },
  { href: '/notes', label: l.t('Patch notes'), match: (path: string) => path.startsWith('/notes') },
  { href: '/stats', label: l.t('Stats'), match: (path: string) => path.startsWith('/stats') },
];
const currentPath = basePath(pagePath(Astro.url));
const languageMenuPath = currentPath === '/404' ? '/' : currentPath;
const pageInLanguage = (target: (typeof LOCALES)[number]) => new Lang(target).href(languageMenuPath);
---

<header class="site-header">
  <div class="mx-auto flex w-full max-w-[80rem] flex-wrap items-center gap-x-3 px-4 pt-2 lg:gap-x-6">
    <a class="flex h-14 items-center gap-2.5 text-ink no-underline" href={l.href('/')}>
      <Image alt="" class="size-10" densities={[1, 2]} height={40} src={characterIcon} width={40} />
      <span class="font-display text-xl">The Alchemist</span>
    </a>
    <span aria-hidden="true" class="basis-full lg:hidden"></span>
    <nav
      aria-label={l.t('Site')}
      class="site-nav -ml-4 min-w-0 flex-1 overflow-x-auto pl-3 [scrollbar-width:none] lg:ml-0 lg:pl-0"
    >
      <ul class="m-0 flex list-none gap-1 p-0">
        {links.map((link) => (
          <li>
            <a
              aria-current={link.match(currentPath) ? 'page' : undefined}
              class="flex h-11 items-center rounded-t-lg px-3 text-[15px] font-medium whitespace-nowrap text-ink-2 no-underline hover:bg-panel hover:text-ink aria-[current=page]:bg-panel aria-[current=page]:text-ink aria-[current=page]:shadow-[inset_0_-2px_0_var(--color-accent)]"
              href={l.href(link.href)}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <details class="lang-menu">
      <summary class="field-control">
        <svg
          aria-hidden="true"
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
          width="16"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.4 2.7 3.6 5.7 3.6 9s-1.2 6.3-3.6 9c-2.4-2.7-3.6-5.7-3.6-9S9.6 5.7 12 3Z" />
        </svg>
        <span class="sr-only">{l.t('Language: {name}', { name: locale.name })}</span>
        <span aria-hidden="true">{locale.short}</span>
      </summary>
      <ul>
        {LOCALES.map((target) => (
          <li>
            <a
              aria-current={target === locale ? 'true' : undefined}
              data-language
              href={pageInLanguage(target)}
              hreflang={target.lang}
              lang={target.lang}
            >
              {target.name}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>

<script>
  import { keepPlace, returnToPlace } from '../scripts/place';

  const menu = document.querySelector<HTMLDetailsElement>('.lang-menu')!;
  for (const link of menu.querySelectorAll<HTMLAnchorElement>('a[data-language]')) {
    link.addEventListener('click', (event) => {
      if (link.hasAttribute('aria-current')) {
        event.preventDefault();
        menu.open = false;
      } else keepPlace(link);
    });
  }
  returnToPlace();
  document.addEventListener('click', (e) => {
    if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  menu.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu.open) return;
    menu.open = false;
    menu.querySelector('summary')!.focus();
  });
</script>
