---
import { itemChanges } from '../lib/content';
import ChangeList from './ChangeList.astro';

interface Props {
  id: string;
}

const { l } = Astro.locals;
const changes = itemChanges(Astro.props.id);
const NEWEST_SHOWN = 4;
const older = changes.slice(NEWEST_SHOWN);
---

{changes.length > 0 && (
  <section>
    <h2 class="mb-3 text-xl">{l.t('Changes')}</h2>
    <ChangeList changes={changes.slice(0, NEWEST_SHOWN)} />
    {older.length > 0 && (
      <details class="mt-3">
        <summary class="cursor-pointer text-sm text-up">
          {l.n(older.length, 'Show {n} older change', 'Show {n} older changes')}
        </summary>
        <ChangeList changes={older} class="mt-3" />
      </details>
    )}
  </section>
)}
