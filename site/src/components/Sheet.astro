---
const { l } = Astro.locals;
---

<dialog aria-labelledby="sheet-title" class="sheet" closedby="any" id="sheet">
  <form method="dialog">
    <button aria-label={l.t('Close')} class="close-button">
      ×
    </button>
  </form>
  <div data-sheet-body></div>
</dialog>

<script src="../scripts/sheet.ts"></script>
