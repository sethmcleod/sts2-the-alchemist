---
import { Image } from 'astro:assets';
import { image } from '../lib/content';
import { type Item, kindName } from '../lib/items';
import GameText from './GameText.astro';
import T from './T.astro';

const { l } = Astro.locals;

interface Props {
  item: Item;
}

const { item } = Astro.props;
const icon = await image(item.info.icon);
const { line, source } = item;
const capitalizedLine = line && line[0].toLocaleUpperCase(l.lang) + line.slice(1);
---

<li class="panel relative grid grid-cols-[4rem_minmax(0,1fr)] gap-3 p-3 hover:border-frame" data-place={item.id}>
  {icon ? <Image alt="" class="size-16 object-contain" src={icon} /> : <span />}
  <div class="grid content-start gap-1">
    <span class="font-display text-lg leading-tight">
      <a class="stretched text-ink no-underline" data-sheet-link href={l.href(item.href)}>
        {item.info.name}
      </a>
      {item.rarity && <small class="ml-1 font-sans text-xs text-muted">{kindName(l, item)}</small>}
    </span>
    <span class="text-sm text-ink-2">
      <GameText markup={item.info.text} />
    </span>
    {(source || line) && (
      <span class="text-xs text-muted tabular-nums">
        {source ? (
          <T text={line ? l.t('From {source}, {line}', { line }) : l.t('From {source}')}>
            <a class="above-stretched" data-sheet-link href={l.href(source.href)} slot="source">
              {source.name}
            </a>
          </T>
        ) : (
          capitalizedLine
        )}
      </span>
    )}
  </div>
</li>
