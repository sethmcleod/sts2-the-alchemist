---
import { Image } from 'astro:assets';
import { image } from '../lib/content';
import type { Item } from '../lib/items';
import { rarityName } from '../lib/views/cards';
import GameText from './GameText.astro';
import T from './T.astro';

const { l } = Astro.locals;

interface Props {
  item: Item;
}

const { item } = Astro.props;
const icon = await image(item.info.icon);
const { source } = item;
---

<li class="item-tile panel" data-place={item.id}>
  {icon ? <Image alt="" class="item-icon" src={icon} /> : <span class="item-icon" />}
  <div class="item-body">
    <span class="item-name">
      <a class="stretched text-ink no-underline" data-sheet-link href={l.href(item.href)}>
        {item.info.name}
      </a>
      {item.rarity && <small>{rarityName(l, item.rarity)}</small>}
    </span>
    <span class="item-text">
      <GameText markup={item.info.text} />
    </span>
    {source && (
      <span class="item-source">
        <T text={l.t('From {source}')}>
          <a class="above-stretched" data-sheet-link href={l.href(source.href)} slot="source">
            {source.name}
          </a>
        </T>
      </span>
    )}
  </div>
</li>
