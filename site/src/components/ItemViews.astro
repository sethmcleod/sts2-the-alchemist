---
import type { Item } from '../lib/items';
import ItemTable from './ItemTable.astro';
import ItemTile from './ItemTile.astro';

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="item-grid">
  {items.map((item) => (
    <ItemTile item={item} />
  ))}
</ul>
<ItemTable items={items} />
