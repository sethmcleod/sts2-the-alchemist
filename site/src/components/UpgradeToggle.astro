---
interface Props {
  name: string;
  restoreOnReload?: boolean;
}

const { name, restoreOnReload = true } = Astro.props;
const { l } = Astro.locals;
---

<label class="upgrade">
  <input
    aria-label={l.t('Switch {name} between base and upgraded', { name })}
    autocomplete={restoreOnReload ? undefined : 'off'}
    class="upgrade-toggle"
    type="checkbox"
  />
  <span aria-hidden="true" class="upgrade-tip">
    <span class="base">{l.t('Show upgraded')}</span>
    <span class="upgraded">{l.t('Show base card')}</span>
  </span>
</label>
