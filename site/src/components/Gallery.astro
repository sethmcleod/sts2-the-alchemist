---
import { getImage, Image } from 'astro:assets';
import { image } from '../lib/content';

interface Props {
  previews: { image: string }[];
}

const { l } = Astro.locals;

const ALT_BY_FILE: Record<string, string> = {
  'preview-1.png': l.t(
    'The Alchemist on the character select screen: a green frog in purple robes with a glowing staff.',
  ),
  'preview-2.png': l.t('The Alchemist in a fight by a waterfall, with a hand of Alchemist cards.'),
  'preview-3.png': l.t('Choosing one of six Mixes to add to the hand.'),
  'preview-4.png': l.t('A rest site that offers Brew next to Rest and Smith.'),
  'preview-5.png': l.t('A choice of three Brew potions.'),
  'preview-6.png': l.t('The Merchant asking to buy a Brew potion.'),
  'preview-7.png': l.t("The Alchemist's mod settings: accessibility, analytics and unlocks."),
};

const { previews } = Astro.props;
const shots = (
  await Promise.all(
    previews.map(async (preview, i) => {
      const src = await image(preview.image);
      if (!src) return null;
      const fileName = preview.image.split('/').at(-1)!;
      const fullSize = await getImage({ format: 'webp', quality: 82, src, width: 1920 });
      return { alt: ALT_BY_FILE[fileName] ?? l.t('Screenshot {n}', { n: i + 1 }), full: fullSize.src, src };
    }),
  )
).filter((shot) => shot !== null);
---

{shots.length > 0 && (
  <div class="gallery panel relative overflow-hidden" data-gallery>
    <ul class="gallery-track m-0 flex list-none snap-x snap-mandatory overflow-x-auto p-0">
      {shots.map((shot, i) => (
        <li class="w-full flex-none snap-center">
          <a class="block" data-full={shot.full} href={shot.full}>
            <Image
              alt={shot.alt}
              class="aspect-video w-full object-cover"
              loading={i ? 'lazy' : 'eager'}
              sizes="(width < 64rem) calc(100vw - 32px), 30rem"
              src={shot.src}
              widths={[480, 960]}
            />
          </a>
        </li>
      ))}
    </ul>
    <button aria-label={l.t('Previous screenshot')} class="gallery-step needs-js left-2" data-step="-1" type="button">
      ‹
    </button>
    <button aria-label={l.t('Next screenshot')} class="gallery-step needs-js right-2" data-step="1" type="button">
      ›
    </button>
    <p aria-hidden="true" class="gallery-count needs-js">
      1 / {shots.length}
    </p>
    <dialog aria-label={l.t('Screenshot')} class="lightbox" closedby="any">
      <form method="dialog">
        <button aria-label={l.t('Close')} class="close-button">
          ×
        </button>
      </form>
      <button aria-label={l.t('Previous screenshot')} class="gallery-step left-2" data-step="-1" type="button">
        ‹
      </button>
      <button aria-label={l.t('Next screenshot')} class="gallery-step right-2" data-step="1" type="button">
        ›
      </button>
    </dialog>
  </div>
)}

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = gallery.querySelector('ul')!;
    const links = [...track.querySelectorAll<HTMLAnchorElement>('a')];
    const counter = gallery.querySelector('.gallery-count')!;
    const lightbox = gallery.querySelector('dialog')!;
    const lightboxImage = document.createElement('img');
    lightbox.querySelector('form')!.after(lightboxImage);
    const currentIndex = () => Math.round(track.scrollLeft / track.clientWidth);
    const wrapIndex = (i: number) => (i + links.length) % links.length;
    let openIndex = 0;

    const showInLightbox = (i: number) => {
      openIndex = wrapIndex(i);
      lightboxImage.src = links[openIndex].dataset.full!;
      lightboxImage.alt = links[openIndex].querySelector('img')!.alt;
    };

    track.addEventListener('scroll', () => (counter.textContent = `${currentIndex() + 1} / ${links.length}`), {
      passive: true,
    });
    gallery.addEventListener('click', (e) => {
      const target = e.target as Element;
      const step = Number(target.closest<HTMLElement>('[data-step]')?.dataset.step);
      const link = target.closest('a');
      if (step && lightbox.open) {
        showInLightbox(openIndex + step);
      } else if (step) {
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollTo({
          behavior: reduceMotion ? 'auto' : 'smooth',
          left: wrapIndex(currentIndex() + step) * track.clientWidth,
        });
      } else if (link) {
        e.preventDefault();
        showInLightbox(links.indexOf(link));
        lightbox.showModal();
      } else if (target === lightbox) {
        lightbox.close();
      }
    });
    lightbox.addEventListener('keydown', (e) => {
      const step = { ArrowLeft: -1, ArrowRight: 1 }[e.key];
      if (step) showInLightbox(openIndex + step);
    });
  }
</script>
