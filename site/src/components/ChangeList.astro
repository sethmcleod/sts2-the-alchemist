---
import type { Change } from '../lib/history';
import { DEFAULT_LOCALE } from '../lib/i18n';
import { notesHref } from '../lib/links';
import NoteList from './NoteList.astro';
import NoteText from './NoteText.astro';

interface Props {
  changes: Change[];
  class?: string;
}

const { changes, class: className } = Astro.props;
const { l, locale } = Astro.locals;
// The notes are written in English only
const notesLang = locale === DEFAULT_LOCALE ? undefined : 'en';
---

<ul class:list={['changes', className]}>
  {changes.map((change) => (
    <li>
      <a class="tabular-nums" href={l.href(notesHref(change.version))}>
        {change.version}
      </a>
      <div lang={notesLang}>
        <NoteText text={change.item.text} />
        {change.item.items.length > 0 && <NoteList items={change.item.items} />}
      </div>
    </li>
  ))}
</ul>
