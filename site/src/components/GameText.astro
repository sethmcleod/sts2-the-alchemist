---
import energyIcon from '../../../Alchemist/images/charui/text_energy.png';
import { energyWords, tokens } from '../lib/markup';

interface Props {
  markup: string;
}

const { markup } = Astro.props;
const { l } = Astro.locals;
---

{tokens(markup).map((token) =>
  token.kind === 'break' ? (
    <br />
  ) : token.kind === 'energy' ? (
    <span aria-label={energyWords(token.count, l.game?.words.Energy).trim()} role="img">
      {Array.from({ length: token.count }, () => (
        <img alt="" class="energy" height="24" src={energyIcon.src} width="24" />
      ))}
    </span>
  ) : token.color ? (
    <span class={`t-${token.color}`}>{token.text}</span>
  ) : (
    token.text
  ),
)}
