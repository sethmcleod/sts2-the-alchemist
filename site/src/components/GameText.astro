---
// Text in the game's loc markup, coloured the way the game colours it
import energyIcon from '../../../Alchemist/images/charui/text_energy.png';
import { energyWords, tokens } from '../lib/markup';

interface Props {
  markup: string;
}

const { markup } = Astro.props;
const { l } = Astro.locals;
---

{tokens(markup).map((t) =>
  t.kind === 'break' ? (
    <br />
  ) : t.kind === 'energy' ? (
    <span aria-label={energyWords(t.count, l.game?.words.Energy).trim()} role="img">
      {Array.from({ length: t.count }, () => (
        <img alt="" class="energy" height="24" src={energyIcon.src} width="24" />
      ))}
    </span>
  ) : t.color ? (
    <span class={`t-${t.color}`}>{t.text}</span>
  ) : (
    t.text
  ),
)}
