---
import { runs } from '../lib/content';
import { keywordName, libraryCards, rarityName, typeName } from '../lib/library';
import { CARD_GROUPS, PARTNER_MODS, partnerMod, RARITIES, RARITY_NAME, slug, steamItem, TYPES } from '../lib/mod';
import type { Rarity } from '../lib/types';
import CardTile from './CardTile.astro';
import External from './External.astro';
import StatsNote from './StatsNote.astro';
import T from './T.astro';

const { l } = Astro.locals;

const runData = runs(Astro.locals.locale);
const cards = libraryCards(l, runData, runs());
const keywords = [...new Set(cards.flatMap((card) => card.info.keywords))]
  .map((word) => [word, keywordName(l, word)])
  .sort(([, a], [, b]) => a.localeCompare(b, l.lang));
const scriptStringKeys = ['{n} cards', '{n} of {total} cards', 'Show {n} cards'];
const scriptWords = JSON.stringify({
  code: l.code,
  lang: l.lang,
  strings: Object.fromEntries(scriptStringKeys.filter((key) => key in l.strings).map((key) => [key, l.strings[key]])),
});

const groupTitle = ({ id, title }: (typeof CARD_GROUPS)[number]) =>
  partnerMod(id) ? title : title === RARITY_NAME[id as Rarity] ? rarityName(l, id as Rarity) : l.t(title);
const groups = CARD_GROUPS.map((group) => ({
  ...group,
  cards: cards.filter((card) => card.group === group.id),
})).filter((group) => group.cards.length);

const selects = [
  {
    label: l.t('Type'),
    name: 'type',
    options: [['', l.t('All types')], ...TYPES.map((type) => [type, typeName(l, type)])],
  },
  {
    label: l.t('Rarity'),
    name: 'rarity',
    options: [['', l.t('All rarities')], ...RARITIES.map((rarity) => [rarity, rarityName(l, rarity)])],
  },
  {
    label: l.t('Cost'),
    name: 'cost',
    options: [['', l.t('Any cost')], ['0'], ['1'], ['2'], ['3', l.t('3 or more')], ['X']],
  },
];
const sortOptions = [
  ['rarity', l.t('Rarity')],
  ['name', l.t('Name')],
  ['cost', l.t('Cost')],
  ['type', l.t('Type')],
  ['vspeers', l.t('Best for its rarity')],
  ['winrate', l.t('Win rate')],
  ['pickrate', l.t('Pick rate')],
  ['playsperrun', l.t('Plays per run')],
  ['unplayed', l.t('Left unplayed')],
  ['held', l.t('Runs')],
];
const selectClass = 'field-control min-w-0';
---

<section aria-labelledby="cards-heading" class="scroll-mt-4" id="cards">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h2 class="m-0 text-3xl" id="cards-heading">
      {l.t('Cards')}
    </h2>
    <output aria-live="polite" class="text-sm text-ink-2 tabular-nums" data-count>
      {l.n(cards.length, '{n} card', '{n} cards')}
    </output>
    <StatsNote class="text-sm text-muted sm:ml-auto" href="/stats/cards" />
  </div>

  <form aria-label={l.t('Cards')} class="toolbar" data-words={scriptWords} id="library" role="search">
    <input
      aria-label={l.t('Search cards')}
      autocomplete="off"
      class="field-control needs-js min-w-0 flex-1 basis-40"
      name="q"
      placeholder={l.t('Search names and text')}
      type="search"
    />
    <button aria-haspopup="dialog" class="button needs-js filters-button" data-open-filters type="button">
      {l.t('Filters')} <span class="count-badge" data-filter-count hidden></span>
    </button>
    <div class="library-filters needs-js" data-filters>
      {selects.map((select) => (
        <select aria-label={select.label} class={selectClass} form="library" name={select.name}>
          {select.options.map(([value, text]) => (
            <option value={value}>{text ?? value}</option>
          ))}
        </select>
      ))}
      <select aria-label={l.t('Keyword or theme')} class={selectClass} form="library" name="keyword">
        <option value="">{l.t('Any keyword')}</option>
        <optgroup label={l.t('Theme')}>
          {runData.meta.themes.map((theme) => (
            <option value={`theme:${theme}`}>{l.t(theme)}</option>
          ))}
        </optgroup>
        <optgroup label={l.t('Keyword')}>
          {keywords.map(([word, name]) => (
            <option value={word}>{name}</option>
          ))}
        </optgroup>
      </select>
      <select aria-label={l.t('Where from')} class={selectClass} form="library" name="from">
        <option value="">{l.t('Any source')}</option>
        <option value="starter">{l.t('Starting deck')}</option>
        <option value="pool">{l.t('Card rewards')}</option>
        <option value="created">{l.t('Created in combat')}</option>
        <option value="coop">{l.t('Multiplayer only')}</option>
        {PARTNER_MODS.map((mod) => (
          <option value={mod.tag}>{mod.name}</option>
        ))}
      </select>
      <select aria-label={l.t('Sort by')} class={selectClass} form="library" name="sort">
        {sortOptions.map(([value, text]) => (
          <option value={value}>{l.t('Sort: {order}', { order: text })}</option>
        ))}
      </select>
    </div>
    <label class="upgrade-all">
      <input form="library" id="all-upgraded" name="upgraded" type="checkbox" />
      <span>{l.t('Show all upgraded')}</span>
    </label>
  </form>

  <div data-groups>
    {groups.map((group) => {
      const partner = partnerMod(group.id);
      return (
        <section aria-labelledby={`group-${slug(group.id)}`} class="mt-6" data-card-group={group.id}>
          <h3 class="m-0 text-xl" id={`group-${slug(group.id)}`}>
            {groupTitle(group)}{' '}
            <small class="font-sans text-sm font-normal text-muted" data-group-count>
              {l.n(group.cards.length, '{n} card', '{n} cards')}
            </small>
          </h3>
          {partner && (
            <p class="m-0 mt-1 text-sm text-muted">
              <T text={l.t('Only in runs with {mod} installed as well.')}>
                <Fragment slot="mod">
                  <External href={steamItem(partner.item)}>{partner.name}</External>
                </Fragment>
              </T>
            </p>
          )}
          <ul class="card-grid">
            {group.cards.map((card) => (
              <CardTile card={card} />
            ))}
          </ul>
        </section>
      );
    })}
  </div>
  <ul class="card-grid mt-6" data-sorted hidden></ul>
  <p class="mt-8 text-center text-muted" data-empty hidden>
    {l.t('No cards match.')}{' '}
    <button class="button ml-2" data-clear type="button">
      {l.t('Clear filters')}
    </button>
  </p>
</section>

<dialog aria-labelledby="drawer-title" class="sheet drawer" closedby="any" data-drawer>
  <form method="dialog">
    <button aria-label={l.t('Close')} class="close-button">
      ×
    </button>
  </form>
  <div class="grid gap-4 p-5">
    <h2 class="m-0 text-2xl" id="drawer-title">
      {l.t('Filter and sort')}
    </h2>
    <div class="grid gap-3" data-drawer-body></div>
    <div class="flex gap-2.5">
      <button class="button flex-1" data-clear type="button">
        {l.t('Clear')}
      </button>
      <button class="button primary flex-1" data-done type="button">
        {l.t('Show cards')}
      </button>
    </div>
  </div>
</dialog>

<script src="../scripts/library.ts"></script>
