---
// The versions the default stats cover, each linked to its patch notes
import { runs } from '../lib/content';
import { notesHref } from '../lib/links';
import { DEFAULT_FILTERS } from '../lib/runs';
import T from './T.astro';

const { l } = Astro.locals;

const [from, to] = runs().versionSpan(DEFAULT_FILTERS.version) ?? [];
---

{from && to && (
  <T text={from === to ? '{from}' : l.t('{from} to {to}')}>
    <a href={l.href(notesHref(from))} slot="from">
      {from}
    </a>
    <a href={l.href(notesHref(to))} slot="to">
      {to}
    </a>
  </T>
)}
