---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { href: string };

const { href, ...rest } = Astro.props;
const { l } = Astro.locals;
---

<a href={href} rel="noopener" target="_blank" {...rest}>
  <slot />
  <span class="sr-only">{` ${l.t('(opens in a new tab)')}`}</span>
</a>
