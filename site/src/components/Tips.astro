---
// The definitions the game shows beside a card or an item for the terms its text marks in gold. The
// game shows them on hover; here they fold under a "Show keyword tips" toggle on a phone and stay
// open on a wide screen (global.css), which needs no script
import { tips } from '../lib/content';
import { DEFAULT_LOCALE } from '../lib/i18n';
import { tipsFor } from '../lib/tips';
import GameText from './GameText.astro';

interface Props {
  markups: string[];
  keywords?: string[];
  /** The item's own name, which gets no tip */
  exclude?: string;
  class?: string;
}

const { markups, keywords, exclude, class: className } = Astro.props;
const { l, locale } = Astro.locals;
// A text the mod has not translated yet reads in English, so the English tips stand behind the page's own
const found = tipsFor(markups, tips(locale), {
  lang: l.lang,
  keywords,
  exclude,
  fallback: locale === DEFAULT_LOCALE ? [] : tips(DEFAULT_LOCALE),
});
---

{found.length > 0 && (
  <details class:list={['tips-more', className]}>
    <summary>{l.t('Show keyword tips')}</summary>
    <ul class="tips" aria-label={l.t('Keywords')}>
      {found.map((tip) => (
        <li class="tip">
          <strong class="tip-title">{tip.title}</strong>
          <span>
            <GameText markup={tip.text} />
          </span>
        </li>
      ))}
    </ul>
  </details>
)}
