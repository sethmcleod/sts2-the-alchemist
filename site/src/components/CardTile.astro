---
import type { LibraryCard } from '../lib/library';
import { cardHref } from '../lib/links';
import CardFace from './CardFace.astro';
import UpgradeToggle from './UpgradeToggle.astro';

const { l } = Astro.locals;

interface Props {
  card: LibraryCard;
}

const { card } = Astro.props;
const { info } = card;
const data = Object.fromEntries(
  Object.entries(card.sort).map(([key, value]) => [`data-${key.toLowerCase()}`, value ?? '']),
);
---

<li
  class="card card-tile relative grid content-start gap-1.5"
  data-cost={info.costs[0]}
  data-group={card.group}
  data-keywords={[...info.keywords, ...info.themes.map((theme) => `theme:${theme}`)].join('|')}
  data-name={info.name}
  data-place={card.id}
  data-rarity={info.rarity}
  data-search={card.search}
  data-tags={info.tags.join('|')}
  data-type={info.type}
  {...data}
>
  <a class="tile-link block rounded-xl no-underline" data-sheet-link href={l.href(cardHref(card.id))}>
    <CardFace
      info={info}
      width={[
        ['(width < 40rem)', '46vw'],
        [null, '13rem'],
      ]}
    />
  </a>
  <UpgradeToggle name={info.name} />
  {info.tags.includes('Multiplayer') && (
    <p class="m-0 text-center text-[13px]">
      <span class="pill">{l.t('Multiplayer')}</span>
    </p>
  )}
</li>
