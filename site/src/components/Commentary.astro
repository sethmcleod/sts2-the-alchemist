---
import { getEntry, render } from 'astro:content';
import { DEFAULT_LOCALE } from '../lib/i18n';

interface Props {
  /** The page path without its leading slash, such as cards/rolling-boil */
  id: string;
}

const { l, locale } = Astro.locals;
const entry = await getEntry('commentary', Astro.props.id);
const Content = entry && (await render(entry)).Content;
---

{Content && (
  <section class="commentary">
    <h2 class="text-xl">{l.t('Design notes')}</h2>
    {/* The notes are written in English only */}
    <div lang={locale === DEFAULT_LOCALE ? undefined : 'en'}>
      <Content />
    </div>
  </section>
)}
