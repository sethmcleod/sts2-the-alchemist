---
import { pagePath } from '../lib/links';
---

<div data-insights data-path={pagePath(Astro.url)} data-route={Astro.routePattern} hidden></div>

<script>
  import { inject, pageview } from '@vercel/analytics';
  import { injectSpeedInsights } from '@vercel/speed-insights';

  const { path, route } = document.querySelector<HTMLElement>('[data-insights]')!.dataset;
  const basePath = import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_BASEPATH;
  const config = import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG;
  inject({ basePath, disableAutoTrack: true, framework: 'astro' }, config);
  pageview({ path, route });
  injectSpeedInsights({ basePath, framework: 'astro', route }, config);
</script>
