---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { image } from '../lib/content';
import { cardFont, textSize, titleSize } from '../lib/fit';
import { typeName } from '../lib/library';
import { RARITY_LOOK } from '../lib/mod';
import type { CardInfo } from '../lib/types';
import GameText from './GameText.astro';

interface Props {
  eager?: boolean;
  info: CardInfo;
  width: [null | string, string][];
}

const { eager = false, info, width } = Astro.props;
const { l, locale } = Astro.locals;
const font = cardFont(locale.game);
const scaledSizes = (scale: number) =>
  width
    .map(([media, length]) => [media, scale === 1 ? length : `calc(${length} * ${scale})`].filter(Boolean).join(' '))
    .join(', ');

const frames = import.meta.glob<{ default: ImageMetadata }>('../assets/frames/*.webp', { eager: true });
const frameImage = (name: string) => frames[`../assets/frames/${name}.webp`].default;

const rarityLook = RARITY_LOOK[info.rarity] ?? RARITY_LOOK.Common;
const ancient = info.rarity === 'Ancient';
const art = await image(info.art);
const loading = eager ? 'eager' : 'lazy';
const artSizes = scaledSizes(ancient ? 1 : 0.76);

const versions = [
  { class: 'base', cost: info.costs[0], name: info.name, text: info.texts[0] },
  { class: 'upgraded', cost: info.costs[1], name: `${info.name}+`, text: info.texts[1] },
];
const costChanged = info.costs[0] !== info.costs[1];
---

<div class:list={['face', { ancient }]} style={`--outline: ${rarityLook.outline}`}>
  {art && (
    <Image
      alt=""
      class="face-art"
      fetchpriority={eager ? 'high' : undefined}
      loading={loading}
      sizes={artSizes}
      src={art}
      widths={[250, 500]}
    />
  )}
  <Image
    alt=""
    class="face-frame"
    loading={loading}
    sizes={scaledSizes(1)}
    src={frameImage(`${info.type.toLowerCase()}_${rarityLook.frame}`)}
    widths={[330, 660]}
  />
  <span class="face-title">
    {versions.map((version) => (
      <span
        class:list={[version.class, 'outlined', { 't-green': version.class === 'upgraded' }]}
        data-text={version.name}
        style={`--size: ${titleSize(version.name, font)}`}
      >
        {version.name}
      </span>
    ))}
  </span>
  <span class="face-type">{typeName(l, info.type)}</span>
  <span class="face-cost">
    {versions.map((version) => (
      <span
        class:list={[version.class, 'outlined', { 't-green': version.class === 'upgraded' && costChanged }]}
        data-text={version.cost}
      >
        <span class="sr-only">{l.t('Costs {cost} Energy.', { cost: version.cost })}</span>
        <span aria-hidden="true">{version.cost}</span>
      </span>
    ))}
  </span>
  <span class="face-text">
    {versions.map((version) => (
      <span class={version.class} style={`--size: ${textSize(version.text, font)}`}>
        <GameText markup={version.text} />
      </span>
    ))}
  </span>
</div>
