---
import type { GetStaticPaths } from 'astro';
import CardSheet from '../../../components/CardSheet.astro';
import Base from '../../../layouts/Base.astro';
import { image, language, runs } from '../../../lib/content';
import { langParams } from '../../../lib/i18n';
import { cardKind, libraryCards } from '../../../lib/library';
import { plain } from '../../../lib/markup';
import { slug } from '../../../lib/mod';

export const getStaticPaths = (() =>
  langParams().flatMap(({ lang, locale }) => {
    const cards = libraryCards(language(locale), runs(locale), runs());
    return cards.map((card, i) => ({
      params: { lang, slug: slug(card.id) },
      props: { card, next: cards[i + 1], previous: cards[i - 1] },
    }));
  })) satisfies GetStaticPaths;

const { card, next, previous } = Astro.props;
const { l } = Astro.locals;
const { info } = card;
const energy = l.game?.words.Energy;
---

<Base
  description={l.t('{name}, {kind}: {text} Upgraded: {upgraded}', {
    kind: cardKind(l, info),
    name: info.name,
    text: plain(info.texts[0], energy),
    upgraded: plain(info.texts[1], energy),
  })}
  image={await image(info.art)}
  title={info.name}
>
  <p class="mt-6 mb-0">
    <a href={l.href('/#cards')}>← {l.t('All cards')}</a>
  </p>
  <span hidden id="upgraded"></span>
  <div class="panel mt-3">
    <CardSheet card={card} next={next} previous={previous} />
  </div>
</Base>

<script>
  const toggle = document.querySelector<HTMLInputElement>('[data-sheet] .upgrade-toggle');
  const flippedByTarget = () => document.querySelector('#upgraded:target') !== null;
  toggle?.addEventListener('change', () =>
    history.replaceState(
      history.state,
      '',
      location.pathname + location.search + (toggle.checked !== flippedByTarget() ? '#upgraded' : ''),
    ),
  );
  let wasTargeted = location.hash === '#upgraded';
  addEventListener('hashchange', () => {
    if (toggle && wasTargeted && !flippedByTarget()) toggle.checked = !toggle.checked;
    wasTargeted = flippedByTarget();
  });
</script>
