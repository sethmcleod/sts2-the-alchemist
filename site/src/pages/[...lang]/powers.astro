---
import ItemTile from '../../components/ItemTile.astro';
import PageHeader from '../../components/PageHeader.astro';
import Sheet from '../../components/Sheet.astro';
import StatsNote from '../../components/StatsNote.astro';
import Base from '../../layouts/Base.astro';
import { runs } from '../../lib/content';
import { everyLanguage } from '../../lib/i18n';
import { powers } from '../../lib/items';

export const getStaticPaths = everyLanguage;

const { l, locale } = Astro.locals;
const items = powers(l, runs(locale));
---

<Base
  description={l.n(
    items.length,
    "The {n} power The Alchemist's cards, relics and potions give.",
    "The {n} powers The Alchemist's cards, relics and potions give.",
  )}
  title={l.t('Powers')}
>
  <PageHeader title={l.t('Powers')}>
    <StatsNote href="/stats/mechanics" />
  </PageHeader>
  <ul class="item-grid">
    {items.map((item) => (
      <ItemTile item={item} />
    ))}
  </ul>
  <Sheet slot="end" />
</Base>
