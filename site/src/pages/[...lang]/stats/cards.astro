---
import CardStats from '../../../islands/CardStats';
import { filterOptions } from '../../../islands/Filters';
import { statsLang } from '../../../islands/useStats';
import Stats from '../../../layouts/Stats.astro';
import { islandLang, runs } from '../../../lib/content';
import { everyLanguage } from '../../../lib/i18n';
import { DEFAULT_FILTERS } from '../../../lib/runs';
import { cardStats } from '../../../lib/views/cards';

export const getStaticPaths = everyLanguage;

const { l, locale } = Astro.locals;
const data = runs(locale);
const islandInit = islandLang(locale);
const statsL = statsLang(islandInit);
---

<Stats description={l.t('How often each Alchemist card is picked, played and won with.')} title={l.t('Card stats')}>
  <CardStats
    client:idle
    initial={cardStats(statsL, data, DEFAULT_FILTERS)}
    locale={islandInit}
    options={filterOptions(statsL, data)}
  />
</Stats>
