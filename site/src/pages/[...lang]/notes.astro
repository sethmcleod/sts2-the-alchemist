---
import External from '../../components/External.astro';
import NoteList from '../../components/NoteList.astro';
import Base from '../../layouts/Base.astro';
import { releases, runs } from '../../lib/content';
import { DEFAULT_LOCALE, everyLanguage } from '../../lib/i18n';
import { releaseHref } from '../../lib/links';

export const getStaticPaths = everyLanguage;

const { l, locale } = Astro.locals;
const versions = releases();
const { meta } = runs(locale);
// The notes are written in English only
const notesLang = locale === DEFAULT_LOCALE ? undefined : 'en';
---

<Base title={l.t('Patch notes')} description={l.t('Every release of The Alchemist, newest first.')}>
  <h1 class="mt-6 mb-2 text-4xl">{l.t('Patch notes')}</h1>
  <p class="m-0 max-w-[65ch] text-ink-2">
    {l.t('Every release, newest first. The beta and public branches get the same notes.')}
    {notesLang && ` ${l.t('Patch notes are in English.')}`}{' '}
    <a href="/notes.xml">{l.t('Follow them in a feed reader')}</a>
  </p>
  <details class="mt-4 text-sm">
    <summary class="cursor-pointer text-up">{l.t('Jump to a version')}</summary>
    <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
      {versions.map((v) => (
        <li>
          <a href={`#${v.version}`} class="block rounded-md border border-line px-2 py-1 tabular-nums no-underline">
            {v.version}
          </a>
        </li>
      ))}
    </ul>
  </details>

  <div class="mt-5 grid grid-cols-[minmax(0,1fr)] gap-4">
    {versions.map((v) => {
      const release = releaseHref(meta.repo, meta.releases, v.version);
      return (
        <article id={v.version} class="panel scroll-mt-4 p-4 sm:p-5">
          <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h2 class="m-0 text-2xl">{v.version}</h2>
            {v.date && (
              <time datetime={v.date} class="text-sm text-muted">
                {l.date(v.date, 'long')}
              </time>
            )}
            {release && (
              <External href={release} class="ml-auto text-sm">
                {l.t('Release on GitHub')}
              </External>
            )}
          </header>
          {v.intro.map((paragraph) => (
            <p class="mt-3 mb-0 max-w-[70ch] text-ink-2" lang={notesLang}>
              {paragraph}
            </p>
          ))}
          {v.sections.map((section) => (
            <section class="mt-3" lang={notesLang}>
              {section.title && (
                <h3 class="mt-0 mb-2 font-sans text-sm font-semibold tracking-wide text-gold uppercase">
                  {section.title}
                </h3>
              )}
              <NoteList items={section.items} />
            </section>
          ))}
        </article>
      );
    })}
  </div>
</Base>
