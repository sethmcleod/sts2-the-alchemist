---
import External from '../../components/External.astro';
import NoteList from '../../components/NoteList.astro';
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import { releases, runs } from '../../lib/content';
import { DEFAULT_LOCALE, everyLanguage } from '../../lib/i18n';
import { releaseHref } from '../../lib/links';

export const getStaticPaths = everyLanguage;

const { l, locale } = Astro.locals;
const allReleases = releases();
const { meta } = runs(locale);
const notesLang = locale === DEFAULT_LOCALE ? undefined : 'en';
---

<Base description={l.t('Every release of The Alchemist, newest first.')} title={l.t('Patch notes')}>
  <PageHeader title={l.t('Patch notes')}>
    <a href="/notes.xml">{l.t('Follow them in a feed reader')}</a>
    <details>
      <summary class="cursor-pointer text-up">{l.t('Jump to a version')}</summary>
      <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
        {allReleases.map((release) => (
          <li>
            <a
              class="block rounded-md border border-line px-2 py-1 tabular-nums no-underline"
              href={`#${release.version}`}
            >
              {release.version}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </PageHeader>

  <div class="grid grid-cols-[minmax(0,1fr)] gap-4">
    {allReleases.map((release) => {
      const githubRelease = releaseHref(meta.repo, meta.releases, release.version);
      return (
        <article class="panel scroll-mt-4 p-4 sm:p-5" id={release.version}>
          <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h2 class="m-0 text-2xl">{release.version}</h2>
            {release.date && (
              <time class="text-sm text-muted" datetime={release.date}>
                {l.date(release.date, 'long')}
              </time>
            )}
            {githubRelease && (
              <External class="ml-auto text-sm" href={githubRelease}>
                {l.t('Release on GitHub')}
              </External>
            )}
          </header>
          {release.intro.map((paragraph) => (
            <p class="mt-3 mb-0 max-w-[70ch] text-ink-2" lang={notesLang}>
              {paragraph}
            </p>
          ))}
          {release.sections.map((section) => (
            <section class="mt-3" lang={notesLang}>
              {section.title && (
                <h3 class="mt-0 mb-2 font-sans text-sm font-semibold tracking-wide text-gold uppercase">
                  {section.title}
                </h3>
              )}
              <NoteList items={section.items} />
            </section>
          ))}
        </article>
      );
    })}
  </div>
</Base>
