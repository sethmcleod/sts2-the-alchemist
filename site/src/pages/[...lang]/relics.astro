---
import ItemViews from '../../components/ItemViews.astro';
import PageHeader from '../../components/PageHeader.astro';
import Sheet from '../../components/Sheet.astro';
import StatsNote from '../../components/StatsNote.astro';
import T from '../../components/T.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import Base from '../../layouts/Base.astro';
import { runs } from '../../lib/content';
import { everyLanguage } from '../../lib/i18n';
import { potions, relics } from '../../lib/items';

const { l } = Astro.locals;

export const getStaticPaths = everyLanguage;

const data = runs(Astro.locals.locale);
const relicItems = relics(l, data);
const potionItems = potions(l, data);
const brewPotions = potionItems.filter((potion) => potion.rarity === 'Brew');
const otherPotions = potionItems.filter((potion) => potion.rarity !== 'Brew');
const description = l.t(
  "The Alchemist's {relics} relics and {potions} potions, with how the runs that used them went.",
  {
    potions: l.num(potionItems.length),
    relics: l.num(relicItems.length),
  },
);
---

<Base description={description} title={l.t('Relics and potions')}>
  <PageHeader title={l.t('Relics and potions')}>
    <ViewToggle slot="actions" />
    <StatsNote href="/stats/relics" />
  </PageHeader>

  <section aria-labelledby="relics">
    <h2 class="m-0 text-2xl" id="relics">
      {l.t('Relics')}
    </h2>
    <ItemViews items={relicItems} />
  </section>

  <section aria-labelledby="potions" class="mt-8">
    <h2 class="m-0 text-2xl" id="potions">
      {l.t('Potions')}
    </h2>
    <ItemViews items={otherPotions} />
  </section>

  <section aria-labelledby="brew" class="mt-8">
    <h2 class="m-0 text-2xl" id="brew">
      {l.t('Brew potions')}
    </h2>
    <p class="mt-1 mb-0 max-w-[65ch] text-sm text-muted">
      {l.t(
        'Brew is a rest site option that offers 3 of these potions to choose from. Nothing else makes them, and the Merchant buys them for 150 Gold.',
      )}
    </p>
    <ItemViews items={brewPotions} />
  </section>

  <p class="mt-8 text-sm">
    <T text={l.t("{stats} compare them with the base game's and show which Ancient choices players take.")}>
      <a href={l.href('/stats/relics')} slot="stats">
        {l.t('Relic and potion stats')}
      </a>
    </T>
  </p>
  <Sheet slot="end" />
</Base>
