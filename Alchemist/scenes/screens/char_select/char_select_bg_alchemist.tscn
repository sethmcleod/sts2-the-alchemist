[gd_scene format=3]

; Alchemist character-select splash. The animated scene is a Spine skeleton with the
; background, character, motion and particles baked in; CharSelectBgPatches builds the
; SpineSprite at runtime (a mod scene cannot hold one, see SpineModel) and adds it under
; this root, found through the Marker child.
;
; The screen adds this scene under its "AnimatedBg" container, which is deliberately
; larger than the viewport (it is grown by -388/-80 on the top-left and +252/+40 on the
; bottom-right so the base game's oversized parallax art bleeds off every edge). The
; root below cancels exactly those offsets, so it lands on the visible 1920x1080 rect.

[node name="AlchemistBg" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 388.0
offset_top = 80.0
offset_right = -252.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 2

[node name="AlchemistSelectMarker" type="Control" parent="."]
layout_mode = 2
visible = false
