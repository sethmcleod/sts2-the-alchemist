[gd_scene format=3]

; Alchemist rest site character. The scene holds only the Control nodes.
;
; BaseLib converts this scene to an NRestSiteCharacter, then AlchemistRestSite adds the Spine model
; as a direct child of the root, which is where NRestSiteCharacter looks for it. The factory builds
; the SelectionReticle from the Hitbox, thus this scene leaves the reticle out.
;
; The Hitbox copies the ironclad rest site scene, which draws inside 421 x 683 at a root scale of
; 0.76, thus about 320 x 519 on screen.

[node name="AlchemistRestSite" type="Node2D"]

[node name="ControlRoot" type="Control" parent="."]
layout_mode = 3
anchors_preset = 0

[node name="Hitbox" type="Control" parent="ControlRoot"]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 0
offset_left = -196.0
offset_top = -267.0
offset_right = 196.0
offset_bottom = 252.0

[node name="ThoughtBubbleRight" type="Control" parent="ControlRoot"]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 0
offset_left = 206.0
offset_top = -250.0
offset_right = 206.0
offset_bottom = -250.0

[node name="ThoughtBubbleLeft" type="Control" parent="ControlRoot"]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 0
offset_left = -206.0
offset_top = -250.0
offset_right = -206.0
offset_bottom = -250.0
